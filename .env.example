# Copy to .env.local for local dev, and set the same vars in Netlify
# (Site settings → Environment variables) for production.

# --- Contact form email delivery (Resend) ---------------------------------
# Until RESEND_API_KEY is set, the contact form still works: it falls back to
# a pre-filled "email us directly" link to CONTACT_EMAIL, so no inquiry is lost.
# To have submissions delivered to your inbox automatically:
#   1. Create a free account at https://resend.com and grab an API key.
#   2. (Recommended) verify your domain in Resend so mail sends from your domain.
#   3. Set the vars below.
RESEND_API_KEY=
# Verified sender. Until your domain is verified in Resend you can use their
# sandbox sender: "Solve Trend Contact <onboarding@resend.dev>"
RESEND_FROM_EMAIL="Solve Trend Contact <onboarding@resend.dev>"
# Where inquiries are delivered. Defaults to hello@solvetrend.com (lib/contact.ts).
CONTACT_EMAIL=hello@solvetrend.com

# --- Job applications (/careers) ------------------------------------------
# Applications are emailed with the resume attached and are never stored —
# no database, no file storage. Uses the same RESEND_API_KEY as above.
# Optional: split applications into their own inbox. Falls back to
# CONTACT_EMAIL, then to hello@solvetrend.com.
CAREERS_EMAIL=
# Resumes are capped at 5MB (PDF/DOC/DOCX) — see RESUME_MAX_BYTES in
# lib/careers.ts. That ceiling exists because serverless functions cap the
# request body around 6MB; raising it here alone won't help.

# --- Site metadata --------------------------------------------------------
# Canonical URL used for SEO/OG tags. Defaults to https://solvetrend.com.
NEXT_PUBLIC_SITE_URL=https://solvetrend.com
